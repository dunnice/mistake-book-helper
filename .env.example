# ==============================================================================
# 错题本助手 (MistakeBook Helper) 环境变量配置模板
# 使用说明：复制本文件为 .env 并填入实际值，.env 已被 .gitignore 忽略，切勿提交！
# ==============================================================================

# 服务端监听端口（默认 8080，生产通常配置 8090）
PORT=8080

# API 接口统一访问鉴权密钥（请求头 X-API-Key）
API_KEY=<API_KEY>

# 服务部署子路径（如 /cuoti，本地根目录开发留空即可）
BASE_PATH=

# 对外公网可访问的完整 URL（用于打印页生成题目二维码，如 https://cuoti.example.com，为空则自动从请求头提取）
PUBLIC_BASE_URL=

# 数据库 DSN 连接串
# 1. 默认使用本地文件数据库 SQLite（留空即可，自动保存在 data/mistakebook.db）：
DB_DSN=
# 2. 若使用 MySQL：
# DB_DSN=username:password@tcp(127.0.0.1:3306)/mistakebook?charset=utf8mb4&parseTime=True&loc=Local

# 自动化部署目标配置（用于 make deploy / script/deploy-aliyun.sh）
DEPLOY_SERVER_HOST=your-server-ip
DEPLOY_SERVER_USER=root
DEPLOY_SERVER_PATH=/opt/mistakebook
